    <item >
        <id>1</id>
        <name> minimize</name>
        <name_zh>最小化当前应用窗口</name_zh>
        <summary>F9</summary>
        <desc></desc>
        <type></type>
    </item>

    <item >
        <id>2</id>
        <name> Home</name>
        <name_zh>返回桌面（HOME键）</name_zh>
        <summary>F10</summary>
        <desc></desc>
        <type></type>
    </item>


    <item >
        <id>3</id>
        <name> full screen / Exit</name>
        <name_zh>应用全屏/取消全屏</name_zh>
        <summary>F11</summary>
        <desc></desc>
        <type></type>
    </item>

    <item >
        <id>4</id>
        <name> Screenshot</name>
        <name_zh>截屏</name_zh>
        <summary>Ctrl + Alt + S</summary>
        <desc></desc>
        <type></type>
    </item>

    <item >
        <id>5</id>
        <name> Area Screenshot</name>
        <name_zh>区域截图</name_zh>
        <summary>Ctrl + Alt + Shift + S</summary>
        <desc></desc>
        <type></type>
    </item>
    <item >
        <id>6</id>
        <name> Recording/Stop</name>
        <name_zh>录屏/停止录屏</name_zh>
        <summary>Ctrl + Shift + R </summary>
        <desc></desc>
        <type></type>
    </item>

